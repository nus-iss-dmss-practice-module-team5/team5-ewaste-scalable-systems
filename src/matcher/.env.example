# Explicit LOCAL TEST examples. Production values and credentials need review.
MATCHER_LOCAL_TEST=1
MATCHER_KAFKA_CONFIG_FILE=/run/config/kafka.json
MATCHER_TOPIC=ewaste.batch.events
MATCHER_DLQ_TOPIC=ewaste.batch.events.matching.dlq.v1
MATCHER_GROUP_ID=matching-workers-local
MATCHER_OFFSET_RESET=earliest
MATCHER_MAX_POLL_MS=300000
MATCHER_SESSION_TIMEOUT_MS=10000
MATCHER_WORKERS=2
MATCHER_FACADE_URL=http://workflow-api:8080
MATCHER_TOKEN_FILE=/run/secrets/matching-worker-token
MATCHER_HTTP_TIMEOUT_SECONDS=5
MATCHER_MAX_RESPONSE_BYTES=10485760
MATCHER_MAX_RECORD_BYTES=1048576
MATCHER_DELIVERY_TIMEOUT_SECONDS=10
MATCHER_RETRY_BASE_SECONDS=1
MATCHER_RETRY_MAX_SECONDS=30
MATCHER_MAX_REFRESHES=3
# Optional aggregate-only HTTP health/readiness endpoint.
MATCHER_HEALTH_PORT=8000
# Azure alternative: omit MATCHER_KAFKA_CONFIG_FILE and set these instead:
# KAFKA_BOOTSTRAP_SERVERS=evh-ewaste-dev.servicebus.windows.net:9093
# KAFKA_CONNECTION_STRING=<namespace-connection-string>
# MATCHER_LOCAL_TEST=0
# Dedicated JWT alternative to MATCHER_TOKEN_FILE:
# MATCHER_SIGNING_SECRET_FILE=/run/secrets/matching-key
# MATCHER_TOKEN_ISSUER=ewaste-matching-dev
# MATCHER_TOKEN_AUDIENCE=ewaste-matching-api-dev
# Use HTTPS facade URL, 30s session timeout, 60s Kafka request timeout,
# and 120s producer delivery timeout for the supplied Azure deployment.
