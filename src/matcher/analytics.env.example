# Copy to analytics.env. Supply the analytics credential through your secret store.
# All numeric values and the facade URL are independent of MATCHER_* settings.
ANALYTICS_LOCAL_TEST=0
ANALYTICS_KAFKA_BOOTSTRAP_SERVERS=evh-ewaste-dev.servicebus.windows.net:9093
ANALYTICS_KAFKA_CONNECTION_STRING=
ANALYTICS_TOPIC=ewaste.batch.events
ANALYTICS_GROUP_ID=analytics-processing-v1
ANALYTICS_OFFSET_RESET=earliest
ANALYTICS_MAX_POLL_MS=300000
ANALYTICS_SESSION_TIMEOUT_MS=30000
ANALYTICS_WORKERS=2
ANALYTICS_FACADE_URL=https://batch-workflow.internal
ANALYTICS_SERVICE_TOKEN=
ANALYTICS_HTTP_TIMEOUT_SECONDS=5
ANALYTICS_MAX_RESPONSE_BYTES=10485760
ANALYTICS_MAX_RECORD_BYTES=1048576
ANALYTICS_RETRY_BASE_SECONDS=1
ANALYTICS_RETRY_MAX_SECONDS=30
ANALYTICS_HEALTH_PORT=8000
