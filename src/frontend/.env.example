# Workflow API origin (no /api/v1 path).
# The browser calls same-origin /api/v1/* ; Next.js rewrites those to API_PROXY_TARGET.
# NEXT_PUBLIC_API_URL is accepted as a fallback (CD sets this on Azure).
#
# Defaults to the Azure DEV API. For a local backend (docker compose), use
# http://localhost:8080 instead.
# Do not use the UI host (aca-ewaste-dev-ui) as API_PROXY_TARGET.
API_PROXY_TARGET=https://aca-ewaste-dev-api.kindflower-300f4866.malaysiawest.azurecontainerapps.io
NEXT_PUBLIC_API_BASE_URL=https://aca-ewaste-dev-api.kindflower-300f4866.malaysiawest.azurecontainerapps.io
NEXT_PUBLIC_API_URL=https://aca-ewaste-dev-api.kindflower-300f4866.malaysiawest.azurecontainerapps.io
# Optional split-service routing. Set all four before next build / next dev.
# Leave all unset to retain API_PROXY_TARGET for the monolith.
# IDENTITY_ACCESS_URL=http://localhost:8081
# BATCH_WORKFLOW_URL=http://localhost:8082
# CLAIM_LOGISTICS_URL=http://localhost:8083
# CUSTODY_VERIFICATION_URL=http://localhost:8084
