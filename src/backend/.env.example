# Copy this file to .env for the test Docker Compose stack.
# Store only credentials and other secrets here. Never commit .env.

MYSQL_PASSWORD=replace-with-a-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password
REDIS_PASSWORD=replace-with-a-redis-password
EWASTE_SERVER_ALLOWED_ORIGINS=http://localhost:3000

# Set these for Azure Event Hubs. The password is the Event Hubs
# authorization-rule connection string and must remain secret.
EWASTE_KAFKA_ENABLED=false
EWASTE_KAFKA_BROKERS=localhost:9092
EWASTE_KAFKA_TLS_ENABLED=false
EWASTE_KAFKA_SASL_MECHANISM=PLAIN
EWASTE_KAFKA_SASL_USERNAME='$ConnectionString'
# KAFKA_CONNECTION_STRING=Endpoint=sb://...;SharedAccessKeyName=...;SharedAccessKey=...

EWASTE_AUTH_ACCESS_SECRET=replace-with-a-long-random-access-secret
EWASTE_AUTH_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
EWASTE_AUTH_REFRESH_HASH_SECRET=replace-with-a-long-random-refresh-hash-secret
EWASTE_AUTH_ANALYTICS_SERVICE_TOKEN=replace-with-a-long-random-analytics-service-token
EWASTE_ANALYTICS_APPROVED_RULE_VERSION=d3-v1

# Matching facade is opt-in; apply approved migrations 001–025 first.
EWASTE_MATCHING_ENABLED=false
# EWASTE_MATCHING_ISSUER=ewaste-matching-dev
# EWASTE_MATCHING_AUDIENCE=ewaste-matching-api-dev
# EWASTE_MATCHING_SIGNING_SECRET=<dedicated-random-secret-at-least-32-bytes>
# EWASTE_MATCHING_SIGNING_SECRET_FILE=/run/secrets/matching-key
# Explicit operator reruns require a DISTINCT signing authority (disabled by default).
# EWASTE_MATCHING_OPERATOR_SIGNING_SECRET=<separate-operator-secret>
# EWASTE_MATCHING_MAX_BODY_BYTES=16777216

# Evidence Storage Adapter Configuration (Decision D2 & Backend Integration)
# Local testing and Docker Compose default to 'local'
STORAGE_ADAPTER_TYPE=local
EWASTE_STORAGE_LOCAL_BASE_DIR=data/evidence

# In Azure, storage uses secretless Managed Identity authentication (no key or connection string required):
# STORAGE_ADAPTER_TYPE=azure_blob
# AZURE_STORAGE_ACCOUNT=stgewastescalabledev
# AZURE_STORAGE_CONTAINER=evidence-private
# AZURE_STORAGE_ENDPOINT=https://stgewastescalabledev.blob.core.windows.net
# AZURE_USE_MANAGED_ID=true
# AZURE_CLIENT_ID=<client-id-of-the-API-user-assigned-managed-identity>
# MAX_UPLOAD_SIZE_BYTES=5242880
# Note: AZURE_STORAGE_ENDPOINT can be omitted if AZURE_STORAGE_ACCOUNT is provided.

# Supplied Azure Event Hubs endpoint; secrets belong in Container Apps secret refs.
# EWASTE_KAFKA_ENABLED=true
# EWASTE_KAFKA_BROKERS=evh-ewaste-dev.servicebus.windows.net:9093
# EWASTE_KAFKA_TLS_ENABLED=true
# EWASTE_KAFKA_SASL_MECHANISM=PLAIN
# EWASTE_KAFKA_SASL_USERNAME='$ConnectionString'
# KAFKA_CONNECTION_STRING=<namespace-connection-string>
# EWASTE_KAFKA_PUBLISH_TIMEOUT=60s
# EWASTE_KAFKA_BATCH_SIZE=1
# EWASTE_KAFKA_LEASE_DURATION=180s
# EWASTE_KAFKA_LEADER_LEASE_DURATION=300s

# Evidence storage adapter. Use local for development/unit tests or azure_blob in Azure.
# The default application configuration remains disabled (fail-closed) until an adapter is selected.
# STORAGE_ADAPTER_TYPE=local
# EWASTE_STORAGE_LOCAL_BASE_DIR=data/evidence
# Private Azure Blob evidence storage uses managed identity; do not add keys or connection strings.
# STORAGE_ADAPTER_TYPE=azure_blob
# AZURE_STORAGE_ACCOUNT=your_storage_account
# AZURE_STORAGE_CONTAINER=evidence-private
# AZURE_STORAGE_ENDPOINT=https://your_storage_account.blob.core.windows.net
# AZURE_USE_MANAGED_ID=true
# MAX_UPLOAD_SIZE_BYTES=5242880
# Backward-compatible aliases are also accepted:
# EWASTE_STORAGE_AZURE_ACCOUNT_NAME
# EWASTE_STORAGE_AZURE_CONTAINER_NAME
# EWASTE_STORAGE_AZURE_ENDPOINT
