{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ewaste:events:RequestSubmitted:v1",
  "title": "RequestSubmitted event v1 — draft",
  "description": "Immutable EWCSB-1 submission fact consumed at the EWCSB-2 Kafka boundary. Kafka key equals batch_id. Cross-field/database checks are in kafka-boundary.md. This reuse changes only the description, not the original v1 wire contract.",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "command_id",
    "batch_id",
    "batch_version",
    "claim_epoch",
    "sequence_in_command",
    "occurred_at",
    "correlation_id",
    "data"
  ],
  "properties": {
    "event_id": {
      "$ref": "#/$defs/uuidV4"
    },
    "event_type": {
      "const": "RequestSubmitted"
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "command_id": {
      "$ref": "#/$defs/uuidV4"
    },
    "batch_id": {
      "$ref": "#/$defs/uuidV4"
    },
    "batch_version": {
      "$ref": "#/$defs/positiveUint32"
    },
    "claim_epoch": {
      "$ref": "#/$defs/positiveUint64String"
    },
    "sequence_in_command": {
      "$ref": "#/$defs/positiveUint32"
    },
    "occurred_at": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "data": {
      "type": "object",
      "required": [
        "organization_id",
        "submitted_at",
        "category",
        "quantity",
        "estimated_weight_kg",
        "condition_rating",
        "is_data_bearing",
        "zone",
        "collection_deadline"
      ],
      "properties": {
        "organization_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[\\x20-\\x7E]+$(?![\\s\\S])",
          "description": "ASCII canonical identity, copied from ewaste_batches.organization_id and matching organisations.organisation_id."
        },
        "submitted_at": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "category": {
          "type": "string",
          "enum": [
            "ICT_EQUIPMENT",
            "LARGE_APPLIANCE",
            "BATTERIES",
            "CONSUMER_ELECTRONICS"
          ]
        },
        "quantity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "estimated_weight_kg": {
          "type": "string",
          "pattern": "^(?:0\\.[1-9][0-9]|[1-9][0-9]{0,3}\\.[0-9]{2}|[1-4][0-9]{4}\\.[0-9]{2}|50000\\.00)$(?![\\s\\S])",
          "description": "Canonical exact decimal string; 0.10 through 50000.00 inclusive, no exponent, sign or extra precision."
        },
        "condition_rating": {
          "type": "string",
          "enum": [
            "FUNCTIONAL",
            "REPAIRABLE",
            "END_OF_LIFE"
          ]
        },
        "is_data_bearing": {
          "type": "boolean"
        },
        "zone": {
          "type": "string",
          "enum": [
            "NORTH",
            "SOUTH",
            "EAST",
            "WEST",
            "CENTRAL"
          ]
        },
        "collection_deadline": {
          "$ref": "#/$defs/utcTimestamp"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "$defs": {
    "uuidV4": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$(?![\\s\\S])",
      "description": "Server-generated canonical lowercase UUIDv4."
    },
    "positiveUint32": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "positiveUint64String": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-4]|18446744073709551615)$(?![\\s\\S])",
      "description": "Canonical decimal string, inclusive range 1 through 18446744073709551615; no leading zeroes."
    },
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[1-9][0-9]{3}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{6}Z$(?![\\s\\S])",
      "description": "UTC RFC3339, exactly six fractional digits, Z; MySQL DATETIME-compatible year. Enable format validation for calendar correctness."
    }
  }
}
